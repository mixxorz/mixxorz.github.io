---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { postHref, postsPerPage, visiblePosts, type Post } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = visiblePosts(await getCollection("posts"));
  return paginate(posts, { pageSize: postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const title = page.currentPage === 1 ? "Archive" : `Archive - Page ${page.currentPage}`;
const description = `Every post published on ${siteConfig.name}.`;
const withTrailingSlash = (url: string | undefined) => (url && !url.endsWith("/") ? `${url}/` : url);
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
const archiveUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: archiveUrl,
  isPartOf: {
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: page.data.map((post, index) => ({
      "@type": "ListItem",
      position: (page.currentPage - 1) * postsPerPage + index + 1,
      name: post.data.title,
      url: new URL(postHref(post), siteConfig.siteUrl).toString(),
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  {structuredData}
>
  <SiteHeader />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Archive</p>
        <h1 class="pagehead-title">All posts</h1>
        <p class="pagehead-description">
          {page.total} {page.total === 1 ? "post" : "posts"}, newest first. Page {page.currentPage} of {page.lastPage}.
        </p>
      </header>

      <div class="feed">
        {page.data.map((post) => <PostCard post={post} />)}
      </div>

      <nav class="mt-16 flex items-center justify-between gap-4 border-t border-border pt-6" aria-label="Archive pagination">
        {
          prevUrl ? (
            <a href={prevUrl} class="nav-link link-nudge">
              <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> Newer
            </a>
          ) : (
            <span class="nav-link opacity-40">&larr; Newer</span>
          )
        }
        <span class="text-xs tracking-widest text-muted-foreground uppercase">
          Page {page.currentPage} / {page.lastPage}
        </span>
        {
          nextUrl ? (
            <a href={nextUrl} class="nav-link link-nudge">
              Older <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
            </a>
          ) : (
            <span class="nav-link opacity-40">Older &rarr;</span>
          )
        }
      </nav>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
