---
import github from "@/icons/bootstrap/github.svg?raw";
import instagram from "@/icons/bootstrap/instagram.svg?raw";
import link45deg from "@/icons/bootstrap/link-45deg.svg?raw";
import linkedin from "@/icons/bootstrap/linkedin.svg?raw";
import rss from "@/icons/bootstrap/rss.svg?raw";
import twitterX from "@/icons/bootstrap/twitter-x.svg?raw";

const icons = {
  github,
  instagram,
  "link-45deg": link45deg,
  linkedin,
  rss,
  "twitter-x": twitterX,
};

type LocalIconName = keyof typeof icons;

interface Props {
  name: LocalIconName;
  className?: string;
}

const { name, className = "h-4 w-4" } = Astro.props;
const icon = icons[name];
---

<span
  class:list={["inline-grid place-items-center [&>svg]:h-full [&>svg]:w-full [&>svg]:fill-current", className]}
  aria-hidden="true"
  set:html={icon}
/>
