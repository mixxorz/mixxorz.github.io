---
import { formatDate, postHref, readingLabel, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  variant?: "lead" | "feed";
  headingLevel?: "h2" | "h3";
  dateLabel?: string;
}

const { post, variant = "feed", headingLevel = "h2", dateLabel } = Astro.props;
const { title, excerpt, date } = post.data;
const Heading = headingLevel;
const isoDate = date.toISOString();
const readableDate = formatDate(date);
---

<article class:list={["card", `card-${variant}`]}>
  <a href={postHref(post)} class="link-title">
    {
      variant === "lead" && (
        <p class="meta card-toprow">
          <span class="meta-accent">
            {dateLabel && `${dateLabel} — `}
            <time datetime={isoDate}>{readableDate}</time>
          </span>
        </p>
      )
    }

    <Heading class="card-title link-title__text">{title}</Heading>
    <p class="card-excerpt">{excerpt}</p>

    <p class="meta card-footer">
      {variant !== "lead" && <time class="meta-accent" datetime={isoDate}>{readableDate}</time>}
      <span>{readingLabel(post)}</span>
    </p>
  </a>
</article>

<style>
  .card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
    word-break: break-word;
  }

  .card-excerpt {
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--foreground) 88%, transparent);
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .card-footer {
    margin: 1rem 0 0;
  }

  .card-toprow {
    margin: 0 0 1rem;
  }

  .card-lead .card-title {
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    line-height: 1.03;
  }

  .card-lead .card-excerpt {
    max-width: 46rem;
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    line-height: 1.4;
  }

  .card-lead .card-footer {
    margin-top: 1.5rem;
  }

  .card-feed .card-title {
    font-size: clamp(1.6rem, 3.6vw, 2.125rem);
    line-height: 1.12;
  }
</style>
